<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- İnternet ve Galeri İzinleri -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_gorunum"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YemekProje">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".AnaMenuActivity"
            android:exported="false" />

        <activity
            android:name=".TarifListesiActivity"
            android:exported="false" />
        
        <activity
            android:name=".MyRecipesActivity"
            android:label="Benim Tariflerim"
            android:exported="false"
            android:parentActivityName=".AnaMenuActivity" />

        <activity
            android:name=".MaterialSelectActivity"
            android:exported="false" />
            
        <activity
            android:name=".TarifDetayActivity"
            android:exported="false" />

    </application>

</manifest>