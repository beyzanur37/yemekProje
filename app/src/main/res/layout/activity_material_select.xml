<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FDFDFD">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mutfağında Neler Var?"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#E65100"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Elindeki malzemeleri seç, sana en uygun tarifleri bulalım."
        android:textSize="14sp"
        android:textColor="#757575"
        android:layout_marginBottom="16dp"/>

    <!-- Malzeme Ekleme Alanı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/editAddMaterial"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Malzeme ekle (Örn: Süt)"
            android:background="@drawable/button_background"
            android:backgroundTint="#F5F5F5"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMaterialChip"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:text="Ekle"
            app:cornerRadius="12dp"
            android:backgroundTint="#E65100"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMaterials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleSelection="false">
            <!-- Burası kod tarafında dolacak -->
        </com.google.android.material.chip.ChipGroup>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerateRecipe"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Tarifleri Bul"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:backgroundTint="#E65100"
        android:layout_marginTop="16dp"/>

</LinearLayout>