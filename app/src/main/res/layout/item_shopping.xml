<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/txtShoppingRecipeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarif Adı"
            android:textStyle="bold"
            android:textColor="#E65100"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtShoppingIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtShoppingRecipeName"
            android:layout_toStartOf="@id/btnDeleteShopping"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:text="Eksik malzemeler..."
            android:textColor="#555555"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnDeleteShopping"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#D32F2F" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
