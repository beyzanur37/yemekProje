<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp">

        <ImageView
            android:id="@+id/imgDetailFood"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- SESLİ OKUMA VE PORSİYON KONTROLLERİ -->
        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="#F5F5F5"
            app:layout_constraintTop_toBottomOf="@id/imgDetailFood"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnSpeak"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#E65100" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Porsiyon: "
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnPortionMinus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_delete"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/txtPortionCount"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="4"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnPortionPlus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="Yemek Adı"
            android:textColor="#333333"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/controlPanel" />

        <TextView
            android:id="@+id/lblIngredients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Malzemeler"
            android:textColor="#E64A19"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/txtDetailTitle"
            app:layout_constraintTop_toBottomOf="@id/txtDetailTitle" />

        <TextView
            android:id="@+id/txtDetailIngredients"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Malzemeler yükleniyor..."
            app:layout_constraintEnd_toEndOf="@id/txtDetailTitle"
            app:layout_constraintStart_toStartOf="@id/txtDetailTitle"
            app:layout_constraintTop_toBottomOf="@id/lblIngredients" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToShoppingList"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eksikleri Listeye Ekle"
            android:textSize="12sp"
            app:icon="@android:drawable/ic_menu_add"
            app:layout_constraintTop_toBottomOf="@id/txtDetailIngredients"
            app:layout_constraintStart_toStartOf="@id/txtDetailIngredients" />

        <TextView
            android:id="@+id/lblInstructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hazırlanışı"
            android:textColor="#E64A19"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/txtDetailTitle"
            app:layout_constraintTop_toBottomOf="@id/btnAddToShoppingList" />

        <TextView
            android:id="@+id/txtDetailInstructions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nasıl yapıldığı yükleniyor..."
            app:layout_constraintEnd_toEndOf="@id/txtDetailTitle"
            app:layout_constraintStart_toStartOf="@id/txtDetailTitle"
            app:layout_constraintTop_toBottomOf="@id/lblInstructions" />

        <!-- Video İzle Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatchVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hazırlanış Videosunu İzle"
            app:icon="@android:drawable/ic_media_play"
            android:backgroundTint="#FF0000"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/txtDetailInstructions"
            app:layout_constraintStart_toStartOf="@id/txtDetailTitle"
            app:layout_constraintEnd_toEndOf="@id/txtDetailTitle"/>

        <View
            android:id="@+id/commentDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnWatchVideo" />

        <!-- YORUMLAR BÖLÜMÜ -->
        <LinearLayout
            android:id="@+id/commentSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/commentDivider"
            app:layout_constraintStart_toStartOf="@id/txtDetailTitle"
            app:layout_constraintEnd_toEndOf="@id/txtDetailTitle">

            <TextView
                android:id="@+id/lblComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yorumlar"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/txtNoComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Henüz yorum yapılmamış. İlk yorumu sen yap!"
                android:textColor="#999999"
                android:textSize="14sp"
                android:padding="8dp"
                android:gravity="center"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <EditText
                    android:id="@+id/editComment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Yorumunuzu yazın..."
                    android:background="@drawable/button_background"
                    android:backgroundTint="#F5F5F5"
                    android:padding="12dp" />

                <ImageButton
                    android:id="@+id/btnSendComment"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#E65100" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>